{
  "name": "apiir",
  "version": "1.0.0",
  "description": "SDK رسمی TypeScript پلتفرم api.ir — احراز هویت، استعلام‌های هویتی و بانکی، OTP پیامکی و صوتی و پیامک با یک کلید یکپارچه",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "example": "tsc && node dist/example.js"
  },
  "keywords": [
    "api.ir",
    "shahkar",
    "otp",
    "sms",
    "iran",
    "sdk"
  ],
  "author": "api.ir <info@api.ir> (https://api.ir)",
  "homepage": "https://api.ir",
  "license": "MIT",
  "dependencies": {
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.4.0"
  }
}
